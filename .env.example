# Paśnik — wzór konfiguracji lokalnej.
# Skopiuj do .env (`cp .env.example .env`) i uzupełnij wartości.
# .env NIGDY nie trafia do repozytorium (07_SECURITY §7).

# --- aplikacja -------------------------------------------------------------
APP_ENV=dev                 # dev | test | prod (prod: cookies Secure + prefiks __Host-, logi JSON)
APP_VERSION=0.1.0           # obraz prod nadpisuje tagiem gita (task build-prod)
LOG_LEVEL=INFO              # poziom logów aplikacji I uvicorna (obraz prod)

# Sekret aplikacji — WYMAGANY, choć dziś ZAREZERWOWANY (decyzja B17, dług U13):
# sesje i tokeny CSRF pochodzą z `secrets.token_urlsafe`, nie z podpisu tym
# kluczem. Zostaje w konfiguracji na podpisywane payloady (np. jednorazowe
# linki), żeby ich dołożenie nie wymagało zmiany każdego .env. Wygeneruj własny:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=zmien-mnie-na-losowy-sekret

# --- obraz prod / uruchomienie (BATCH_17; compose.prod spina B18) ----------
# Liczba workerów uvicorna (docker/entrypoint.sh). Licznik rate limitów jest
# per proces — realny sufit to N × wartość (09_DEPLOYMENT §2).
UVICORN_WORKERS=2
# Adresy proxy, którym uvicorn ufa w X-Forwarded-For/-Proto. Za Caddym (D7)
# połączenie do kontenera przychodzi z bramy sieci dockera — B18 wpisuje tu tę
# bramę (albo `*`, bo port aplikacji jest opublikowany WYŁĄCZNIE na 127.0.0.1).
# Domyślne 127.0.0.1 = ufaj tylko loopbackowi (dev).
FORWARDED_ALLOW_IPS=127.0.0.1
# Próg wolnego miejsca na dysku danych; poniżej /api/v1/health = degraded.
DISK_MIN_FREE_MB=1024
# Katalog zbudowanego SPA serwowanego przez backend (ADR-014). Pusty w dev
# (vite dev server); obraz prod ustawia /app/static sam.
SPA_DIST_DIR=

# Próg podobieństwa wyszukiwarki produktów (pg_trgm, 0..1). Niżej = więcej
# trafień przy literówkach, ale i więcej szumu.
CATALOG_SEARCH_SIMILARITY_THRESHOLD=0.25

# Katalog uploadów (zdjęcia przepisów/produktów, PDF-y importu) — poza
# web-rootem; serwowane wyłącznie przez endpoint z sesją (07_SECURITY §6).
UPLOADS_DIR=data/uploads

# Limit paczki transferu (eksport/import logiczny) w MB — 07_SECURITY §6.
TRANSFER_MAX_ZIP_MB=100

# Limit wgrywanego jadłospisu PDF (importer) w MB — 07_SECURITY §6.
PDF_MAX_UPLOAD_MB=25

# Limit zdjęcia (przepisy, warianty sklepowe) w MB — 07_SECURITY §6 (B17: z env).
IMAGE_MAX_UPLOAD_MB=10

# Sufit ciała ŻĄDANIA dla ścieżek, które nie są uploadem, w MB (B17).
# Uploady mają własne sufity = ich limit + 1 MB marginesu multiparta.
REQUEST_MAX_BODY_MB=2

# Sufit czasu parsowania jednego PDF-a w sekundach (B17, dług U24) — przerywa
# żądanie, nie wątek; na wolniejszym hoście podnieś zamiast zmieniać kod.
PDF_PARSE_TIMEOUT_S=60

# --- AI-asysta importu PDF (BATCH_16, ADR-011, decyzja D5) -----------------
# Klucz Claude API. MOŻE ZOSTAĆ PUSTY — wtedy importer pracuje w pełni
# deterministycznie (mapowania i porcje ustawia człowiek), a przycisk
# „Zaproponuj z AI" znika z ekranu review. Klucz jest wyłącznie server-side:
# nie pojawia się w żadnej odpowiedzi API ani w logach (07_SECURITY §7/§8).
# Na produkcji plik .env ma mieć chmod 600 (checklista B17).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_S=45

# --- baza danych -----------------------------------------------------------
# Host uruchamiający `task check` / alembic łączy się przez port opublikowany
# na 127.0.0.1 przez docker/compose.dev.yml. Wewnątrz compose adresem jest `db`
# (kontener app dostaje DATABASE_URL z compose, nie z tego pliku).
DATABASE_URL=postgresql+psycopg://pasnik:pasnik_dev_haslo@127.0.0.1:5432/pasnik

# Baza testów integracyjnych (kontener db-test, dane na tmpfs).
TEST_DATABASE_URL=postgresql+psycopg://pasnik:pasnik_dev_haslo@127.0.0.1:5433/pasnik_test

# Parametry kontenerów PostgreSQL z compose.dev.yml.
POSTGRES_USER=pasnik
POSTGRES_PASSWORD=pasnik_dev_haslo
POSTGRES_DB=pasnik
POSTGRES_TEST_DB=pasnik_test

# --- porty dev -------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# --- stack testowy obrazu prod i backup (docker/compose.test.yml, B17) -------
# Tag obrazu pasnik-app użyty przez compose.test (task build-prod nadaje też :latest).
PASNIK_IMAGE_TAG=latest
# Port hosta, na którym stack testowy wystawia app (127.0.0.1 only).
PASNIK_TEST_PORT=8081
# Katalog hosta na backupy stacku testowego — gdy nieustawiony, wolumen nazwany
# `backups`. Drill restore (task backup-drill) potrzebuje katalogu hosta,
# bo `down -v` kasuje wolumeny.
# PASNIK_TEST_BACKUPS_DIR=C:/dev/pasnik-backups-test
# Godzina codziennego backupu (strefa TZ), retencja 7 dziennych + 4 tygodniowe.
BACKUP_AT=03:00
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Plik env do włączenia w zestaw backupu (09 §3) — ścieżka WEWNĄTRZ kontenera
# backup. Domyślnie pusty: env żyje na hoście, B18 decyduje, czy go montować.
BACKUP_ENV_FILE=
TZ=Europe/Warsaw

# --- konto administratora (task create-admin) ------------------------------
# Domyślnie CLI pyta o email i hasło interaktywnie. Poniższe zmienne służą
# WYŁĄCZNIE do uruchomień nieinteraktywnych (skrypt E2E, pierwsze wdrożenie) —
# zostaw je zakomentowane i nie wpisuj tu hasła produkcyjnego.
# PASNIK_ADMIN_EMAIL=e2e@example.com
# PASNIK_ADMIN_PASSWORD=
# PASNIK_ADMIN_DISPLAY_NAME=Administrator

# --- frontend / E2E --------------------------------------------------------
# Adres backendu dla proxy vite (dev) oraz baseURL dla testów Playwright.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
E2E_BASE_URL=http://127.0.0.1:5173

# Konto używane przez smoke E2E. Utwórz je komendą `task create-admin`
# i wpisz TE SAME dane poniżej. Hasło min. 10 znaków, wymyśl własne —
# w repozytorium nie ma i nie może być żadnego działającego hasła.
E2E_ADMIN_EMAIL=e2e@example.com
E2E_ADMIN_PASSWORD=
