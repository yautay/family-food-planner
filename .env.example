# Family Food Planner — wzór konfiguracji lokalnej.
# Skopiuj do .env (`cp .env.example .env`) i uzupełnij wartości.
# .env NIGDY nie trafia do repozytorium (07_SECURITY §7).

# --- aplikacja -------------------------------------------------------------
APP_ENV=dev                 # dev | test | prod
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Sekret sesji i tokenów CSRF (B02). Wygeneruj własny, np.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=zmien-mnie-na-losowy-sekret

# --- baza danych -----------------------------------------------------------
# Host uruchamiający `task check` / alembic łączy się przez port opublikowany
# na 127.0.0.1 przez docker/compose.dev.yml. Wewnątrz compose adresem jest `db`
# (kontener app dostaje DATABASE_URL z compose, nie z tego pliku).
DATABASE_URL=postgresql+psycopg://ffp:ffp_dev_haslo@127.0.0.1:5432/ffp

# Baza testów integracyjnych (kontener db-test, dane na tmpfs).
TEST_DATABASE_URL=postgresql+psycopg://ffp:ffp_dev_haslo@127.0.0.1:5433/ffp_test

# Parametry kontenerów PostgreSQL z compose.dev.yml.
POSTGRES_USER=ffp
POSTGRES_PASSWORD=ffp_dev_haslo
POSTGRES_DB=ffp
POSTGRES_TEST_DB=ffp_test

# --- porty dev -------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# --- frontend / E2E --------------------------------------------------------
# Adres backendu dla proxy vite (dev) oraz baseURL dla testów Playwright.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
E2E_BASE_URL=http://127.0.0.1:5173
