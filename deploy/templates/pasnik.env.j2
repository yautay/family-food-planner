# {{ ansible_managed }}
# Konfiguracja usługi Paśnik. Plik jest `EnvironmentFile=` unitu systemd ORAZ
# źródłem środowiska `pasnik-cli` (ta sama składnia, ten sam odczyt): obowiązuje
# `KLUCZ=wartość`, BEZ `export`, BEZ interpolacji, BEZ spacji i cudzysłowów
# w wartościach (pilnuje tego `tests/unit/test_deploy_config.py` — wartość ze
# spacją inaczej czyta systemd, a inaczej powłoka; dług nr 1 runnera).
#
# Prawa 0640 root:pasnik, katalog {{ env_dir }} (0750 root:pasnik). Plik NIE jest
# częścią release'u i nie ginie przy rollbacku — dlatego zakłada go provision,
# a nie deploy, i tylko RAZ (`force_env: false`; rotacja hasła: `-e force_env=true`).
#
# Źródłem prawdy dla listy zmiennych jest `backend/app/core/config.py` (`Settings`)
# i `backend/scripts/serve.sh`. Rozjazd zatrzymuje bramkę — test_deploy_config.
#
# `APP_VERSION` CELOWO tu nie ma: wersję release'u podaje `serve.sh` z pliku
# VERSION w `current/` (zmienia się z każdym deployem, a ten plik powstaje raz).

# --- aplikacja ---------------------------------------------------------------
APP_ENV=prod
LOG_LEVEL={{ log_level }}
# Jedyny sekret poza SECRET_KEY: hasło roli `{{ db_user }}` w DATABASE_URL
# (zakodowane procentowo — znaki specjalne nie psują adresu).
DATABASE_URL=postgresql+psycopg://{{ db_user | urlencode }}:{{ db_password | urlencode | replace('/', '%2F') }}@{{ db_host }}:{{ db_port }}/{{ db_name }}
# WYMAGANY, choć dziś nieużywany w kodzie (07_SECURITY §7, decyzja B17).
SECRET_KEY={{ secret_key }}
CATALOG_SEARCH_SIMILARITY_THRESHOLD={{ catalog_search_similarity_threshold }}

# --- pliki i limity ----------------------------------------------------------
# ABSOLUTNE ścieżki: względna rozwiązałaby się w katalogu release'u i znikała
# z każdym deployem (09 §5).
UPLOADS_DIR={{ uploads_dir }}
SPA_DIST_DIR={{ deploy_to }}/{{ ansistrano_current_dir }}/frontend/dist
TRANSFER_MAX_ZIP_MB={{ transfer_max_zip_mb }}
IMAGE_MAX_UPLOAD_MB={{ image_max_upload_mb }}
REQUEST_MAX_BODY_MB={{ request_max_body_mb }}
DISK_MIN_FREE_MB={{ disk_min_free_mb }}

# --- uruchomienie (backend/scripts/serve.sh) ---------------------------------
UVICORN_WORKERS={{ uvicorn_workers }}
# Adres hosta na moście Incusa — źródło połączeń Caddy → kontener, jedyny, któremu
# uvicorn ufa w X-Forwarded-For. `*` jest ZABRONIONE (07_SECURITY §7).
FORWARDED_ALLOW_IPS={{ forwarded_allow_ips }}
